SELECT u.id, u.name, u.status, o.id AS order_id, o.amount, o.order_status, o.created_at
FROM users u
JOIN orders o ON o.user_id = u.id
ORDER BY u.id
LIMIT 10;
SELECT u.id, u.name, u.status, o.id AS order_id, o.amount, o.order_status, o.created_at
FROM users u
JOIN orders o ON o.user_id = u.id
ORDER BY u.id
LIMIT 10;
SELECT
    u.id, u.name,
    COUNT(o.id)            AS order_count,
    ROUND(SUM(o.amount),2) AS total_spent
FROM users u
JOIN orders o ON o.user_id = u.id
GROUP BY u.id, u.name
HAVING COUNT(o.id) > 200
ORDER BY total_spent DESC;
SELECT name, COUNT(*) AS occurrences, GROUP_CONCAT(email) AS emails
FROM users
GROUP BY name
HAVING COUNT(*) > 1;
SELECT id, user_id, amount, order_status, created_at
FROM orders
WHERE order_status = 'completed'
  AND created_at BETWEEN '2025-06-01' AND '2025-06-30'
ORDER BY created_at
LIMIT 10;




